# ==============================================================================
# AegisRansom-X Environment Configuration Template (.env.example)
# Runtime: macOS (Apple Silicon) · 100% Offline Local ML
# ==============================================================================

# Monitored directory (strictly confined to sandbox for live demo safety)
AEGIS_WATCH_DIRECTORY=./sandbox_targets/

# Chunk size for Shannon entropy sampling in bytes (4KB head/tail sampling)
AEGIS_ENTROPY_CHUNK_SIZE_BYTES=4096

# Shannon entropy threshold (0.0 to 8.0) indicating cryptographic encryption
AEGIS_ENTROPY_THRESHOLD=7.50

# Enable non-destructive POSIX SIGSTOP process suspension
AEGIS_CRYO_FREEZE_ENABLED=true

# Enable micro-canary honeyfile trapdoors in watched directory
AEGIS_CANARY_TRAPS_ENABLED=true

# Composite risk score threshold (0-100) to trigger immediate Cryo-Freeze
AEGIS_CRITICAL_RISK_THRESHOLD=80.0

# Backend FastAPI bind settings
AEGIS_API_HOST=127.0.0.1
AEGIS_API_PORT=8000

# SQLite audit database path
AEGIS_DATABASE_PATH=./aegis_audit.db

# Frontend CORS origins
AEGIS_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Structured logging level: DEBUG, INFO, WARNING, ERROR
AEGIS_LOG_LEVEL=INFO
